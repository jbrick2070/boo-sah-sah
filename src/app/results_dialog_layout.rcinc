STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "BOO SAH SAH"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_RESULTS_TITLE, 8, 6, 306, 17, SS_CENTERIMAGE | SS_NOPREFIX
    CONTROL "", IDC_RESULTS_RASTER, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 9, 26, 304, 14
    CONTROL "", IDC_RESULTS_PT, "BUTTON", BS_AUTORADIOBUTTON, 9, 43, 304, 14
    CONTROL "", IDC_RESULTS_DLSS, "BUTTON", BS_AUTORADIOBUTTON, 9, 60, 304, 14
    LTEXT "", IDC_RESULTS_SUBTITLE, 8, 21, 306, 15, SS_NOPREFIX | NOT WS_VISIBLE
    CONTROL "", IDC_RESULTS_TABLE, "SysListView32", WS_CHILD | WS_TABSTOP | WS_GROUP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | NOT WS_VISIBLE, 8, 36, 306, 66
    EDITTEXT IDC_RESULTS_BODY, 8, 80, 306, 98, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT "", IDC_RESULTS_NOTE, 8, 164, 306, 16, SS_NOPREFIX | NOT WS_VISIBLE
    DEFPUSHBUTTON "", IDOK, 8, 182, 99, 24, BS_MULTILINE
    PUSHBUTTON "", IDC_RESULTS_SAVE, 8, 182, 99, 24, BS_MULTILINE | NOT WS_VISIBLE
    PUSHBUTTON "", IDC_RESULTS_REPORT, 112, 182, 97, 24, BS_MULTILINE | NOT WS_VISIBLE
    PUSHBUTTON "", IDCANCEL, 215, 182, 99, 24, BS_MULTILINE
END
